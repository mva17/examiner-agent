# Скопируйте в .env и впишите свой ключ. Файл .env в git не попадает.

# fake  — встроенная демо-модель без ключа и без интернета (только для демо и тестов)
# openai — любой OpenAI-совместимый API (Cloud.ru, OpenRouter, llama.cpp)
LLM_PROVIDER=fake

# Основная модель. Cloud.ru Foundation Models (работает из РФ без VPN):
LLM_BASE_URL=https://foundation-models.api.cloud.ru/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3-vl-30b-a3b-instruct
# OpenRouter (из РФ только с VPN): LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=qwen/qwen3-235b-a22b-2507
# llama.cpp локально:              LLM_BASE_URL=http://127.0.0.1:8080/v1      LLM_MODEL=qwen3

# Запасная модель (необязательно): включается при ошибке сети или лимите основной
FALLBACK_BASE_URL=
FALLBACK_API_KEY=
FALLBACK_MODEL=

# Гардрейлы
LLM_TIMEOUT_S=30
MAX_QUESTIONS=5
MAX_LLM_CALLS=40
MAX_SEARCH_ATTEMPTS=2
MAX_ANSWER_CHARS=2000

# Поиск по методичкам: bm25 (демо-тексты из data/manuals) | chroma (база Оскара)
SEARCH_BACKEND=bm25
MANUALS_DIR=data/manuals
CHROMA_DIR=data/index
CHROMA_COLLECTION=manuals

# Долгая память слабых тем и журнал обратной связи
MEMORY_DB=var/memory.sqlite3
FEEDBACK_LOG=var/feedback.jsonl

# Адрес API для чата Streamlit
API_URL=http://127.0.0.1:8000
